[server]
# Bind address
host = "0.0.0.0"
# Listen port
port = 8000

[stream]
# ICY metadata interval in bytes (standard: 8192)
metaint = 8192
# Ring buffer size in KB (minimum 64; 512 is about 32s at 128kbps)
buffer_size = 512

[admin]
# Password for /status endpoint (empty = open)
password = ""

[log]
# debug, info, warn, error
level = "info"

# Each [stations.<id>] block creates a station at /<id>/stream
# Example: [stations.pop] → /pop/stream, /pop/stream.pls, /pop/status

[stations.pop]
name = "Pop Station"
description = "Pop Music 24/7"
genre = "Pop"
url = ""
path = "/music/pop"
shuffle = true
recursive = true
# expose_tracks = true                        # Publish the library as individual
                                              # files: /pop/tracks (JSON index),
                                              # /pop/tracks.m3u, /pop/tracks/{id}.
                                              # Off by default; streaming a library
                                              # and offering it for download are
                                              # different things, so opt in per station.
# intro_file = "/radio/assets/intro.mp3"     # Audio played once per listener
# ads_path = "/radio/ads"                     # Directory of ads (or single audio file)
# ad_every_n_songs = 5                        # Inject ad after every N songs (0 = off)
# ad_every_n_minutes = 15                     # Inject ad after every N minutes (0 = off)
# ad_shuffle = true                           # Randomize ad order (false = round-robin)

[stations.jazz]
name = "Jazz Station"
description = "Smooth Jazz"
genre = "Jazz"
url = ""
path = "/music/jazz"
shuffle = true
recursive = true
